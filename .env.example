# Neon Postgres bağlantısı (Neon panelinden "Pooled connection" adresi)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# `npx tsx scripts/gen-keys.ts "<yönetici şifresi>"` komutunun çıktısını buraya yapıştırın.
# Bilet imzalama özel anahtarı (base64url, 32 bayt). ASLA paylaşmayın.
TICKET_SIGNING_SECRET=
# Bilet doğrulama açık anahtarı (base64url). Kapı ekranı çevrimdışı doğrulama için kullanır.
NEXT_PUBLIC_TICKET_PUBLIC_KEY=
# Oturum çerezlerini imzalamak için rastgele anahtar (base64url).
SESSION_SECRET=
# Yönetici şifresinin bcrypt özeti, base64url ile kodlanmış ($ karakterleri .env'de sorun çıkarmasın diye).
ADMIN_PASSWORD_BCRYPT_B64=

# Sitenin genel adresi (e-postadaki bilet linkleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-posta (Gün 6)
RESEND_API_KEY=
EMAIL_FROM="Alucra GençFest <bilet@ornek-alanadi.com>"
